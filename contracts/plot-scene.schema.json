{
  "$defs": {
    "AddExpr": {
      "properties": {
        "kind": {
          "const": "add",
          "default": "add",
          "title": "Kind",
          "type": "string"
        },
        "operands": {
          "items": {
            "discriminator": {
              "mapping": {
                "add": "#/$defs/AddExpr",
                "constant": "#/$defs/ConstantExpr",
                "measurement": "#/$defs/MeasurementExpr",
                "normalize": "#/$defs/NormalizeExpr",
                "ratio": "#/$defs/RatioExpr"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/MeasurementExpr"
              },
              {
                "$ref": "#/$defs/NormalizeExpr"
              },
              {
                "$ref": "#/$defs/RatioExpr"
              },
              {
                "$ref": "#/$defs/AddExpr"
              },
              {
                "$ref": "#/$defs/ConstantExpr"
              }
            ]
          },
          "minItems": 2,
          "title": "Operands",
          "type": "array"
        }
      },
      "required": [
        "operands"
      ],
      "title": "AddExpr",
      "type": "object"
    },
    "Annotation": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "anchor_x": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Anchor X",
          "type": "number"
        },
        "anchor_y": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Anchor Y",
          "type": "number"
        },
        "font_size_pt": {
          "default": 7.0,
          "maximum": 36.0,
          "minimum": 4.0,
          "title": "Font Size Pt",
          "type": "number"
        },
        "color": {
          "default": "#000000",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "title": "Color",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text",
        "anchor_x",
        "anchor_y"
      ],
      "title": "Annotation",
      "type": "object"
    },
    "AxisScene": {
